# Runtime environment. Copy to `.env` for local development (`npm run dev` and
# `npm start` read it); in Coolify, set the same variables on the application as
# runtime secrets, never as build arguments.

# The Shopify store. PUBLIC_STOREFRONT_ID is optional and turns on Shopify Analytics.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PRIVATE_STOREFRONT_API_TOKEN=
# Public Storefront API token, only if you switch to a public (browser-safe) client.
# Leave commented out: an empty assignment is parsed as "" and rejected.
# PUBLIC_STOREFRONT_API_TOKEN=

# Customer Accounts (over HTTPS: `npm run dev:https` locally). Set all three to
# enable `/account`. SESSION_SECRET signs the session cookie; use at least 32
# random characters.
SHOP_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SESSION_SECRET=

# Newsletter and contact forms, and the setup scripts (server only, never exposed
# to the browser). A Dev Dashboard app installed on the store; its client ID and
# secret let the server fetch short-lived Admin tokens, renewed automatically.
# Without them the forms show "not connected yet" instead of saving.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Optional: pin canonical and share URLs to one host (e.g. https://plainwellbody.com)
# when the storefront is reachable on several. Defaults to the requested host.
# PUBLIC_CANONICAL_ORIGIN=

# Setup script only: the sales channel (publication) the storefront reads, matched
# by name, and the BMFX/plainwellbody checkout that holds the seed photography.
# PW_PUBLICATION=for Plainwell Body Co.
# PLAINWELL_REPO=../plainwell

# The Dockerfile sets NODE_ENV=production, PORT=3000 and TRUST_PROXY=true (Coolify
# terminates HTTPS on its proxy). Don't set NODE_ENV here: `npm run dev` reads this file.
